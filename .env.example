# HeadsUp Inbox backend — salin ke .env lalu isi BOT_TOKEN.
# Tanpa BOT_TOKEN server jalan dalam mode DEMO (data contoh, tidak kirim Telegram).

# Token bot dari @BotFather (langkah manual pemilik akun Telegram).
BOT_TOKEN=

# Opsional: paksa chat id pemilik (default: chat privat pertama yang menulis ke bot).
OWNER_CHAT_ID=

# Port backend (frontend mem-proxy /api ke sini saat dev).
PORT=8787

# Opsional: hook LLM kompatibel OpenAI untuk ringkasan + draf.
# Kosong = mesin deterministik (ekstraktif + template intent).
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
